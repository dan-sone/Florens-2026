{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guide schema v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./guide.schema.v5.json"
    },
    "schemaVersion": {
      "const": 5
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "searchSuffix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "searchSuffix"
      ]
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ]
        },
        "zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      },
      "required": [
        "center",
        "zoom"
      ]
    },
    "defaultSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                },
                "minItems": 1
              }
            },
            "required": [
              "nodes"
            ]
          },
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "label",
        "program"
      ]
    },
    "days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/day"
      },
      "minItems": 1
    },
    "bookings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/booking"
      },
      "minItems": 0
    },
    "persistentPlaceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "booked",
              "see-do",
              "craft",
              "food-drink",
              "shopping",
              "hotel"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "minItems": 1
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/override"
          }
        }
      },
      "required": [
        "placeOverrides"
      ]
    },
    "flights": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flight"
      }
    },
    "discoveryAreas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "intro",
          "placeIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "intro": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "placeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "contentVersion",
    "updatedAt",
    "id",
    "title",
    "destination",
    "timeZone",
    "map",
    "defaultSelection",
    "days",
    "bookings",
    "persistentPlaceIds",
    "categories",
    "presentation",
    "flights"
  ],
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "text",
                "strong",
                "emphasis"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "place"
            },
            "placeId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "placeId",
            "text"
          ]
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string"
        },
        "tooltip": {
          "type": "boolean"
        },
        "directionsUsesAddress": {
          "type": "boolean"
        },
        "mapLabel": {
          "type": "string",
          "minLength": 1
        },
        "descriptionSeparator": {
          "type": "string",
          "minLength": 1
        },
        "markerGeometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iconSize",
            "iconAnchor",
            "popupAnchor"
          ],
          "properties": {
            "iconSize": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "iconAnchor": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "popupAnchor": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "required": [
        "markerGeometry",
        "style",
        "tooltip",
        "directionsUsesAddress",
        "mapLabel"
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "program": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                },
                "minItems": 1
              }
            },
            "required": [
              "nodes"
            ]
          },
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "date",
        "label",
        "routeIds",
        "program"
      ]
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "placeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "placeId",
        "startsAt"
      ]
    },
    "flightEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "airportCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "airportName": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "terminal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "airportCode",
        "airportName",
        "city",
        "at",
        "timeZone"
      ]
    },
    "flight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "dayId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "flightNumber": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}$"
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "onBehalfOf": {
          "type": "string",
          "minLength": 1
        },
        "departure": {
          "$ref": "#/$defs/flightEndpoint"
        },
        "arrival": {
          "$ref": "#/$defs/flightEndpoint"
        }
      },
      "required": [
        "id",
        "dayId",
        "flightNumber",
        "operator",
        "departure",
        "arrival"
      ]
    }
  }
}
