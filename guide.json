          ]
        },
        {
          "nodes": [
            {
              "type": "text",
              "text": "Santa Reparata: Porta del Campanile på södra sidan, cirka 5 minuter före bokad tid. Baptisteriet: Porta Sud. Ghiberti Pass omfattar inte kupolen eller klocktornet."
            }
          ]
        }
      ],
      "summary": "Duomo & födelsedagsmiddag"
    },
