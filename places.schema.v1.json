{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Florens 2026 – platsregister, schema version 1",
  "description": "Struktur för places.json. Schema och innehåll versioneras separat. pending/unresolved tillåter okända uppgifter; verified kräver fullständig dokumenterad kontroll.",
  "$comment": "Validatorn ska aktivera formatkontroll. Separata kontroller måste säkerställa unika places[].id, giltiga ruttreferenser, konsekvens mellan Apple Place ID och platslänk, att platslänk öppnar rätt informationskort samt faktisk geografisk riktighet. updatedAt avser senaste innehållsändringen; verification.checkedAt avser senaste fullständiga platskontrollen. Skapande och varje innehållsändring ger en ny contentVersion. Endast verifierade poster får publiceras som kontrollerade kartplatser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "updatedAt",
    "places"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Valfri referens till denna schemafil."
    },
    "schemaVersion": {
      "const": 1,
      "description": "Version av datastrukturen; ändras endast när schema/semantik ändras."
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Version av innehållet; höjs vid varje innehållsändring."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Tidpunkt för senaste innehållsändring, med tidszon."
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      },
      "description": "Unika interna plats-ID:n krävs; kontrolleras separat."
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "appleMaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placeId",
        "placeUrl"
      ],
      "properties": {
        "placeId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^I[0-9A-F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "placeUrl": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://maps\\.apple\\.com/",
              "description": "Direkt platskort eller delningslänk till rätt plats. En adress-/namnsökning är inte en verifierad platslänk."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "position",
        "source"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "checkedAt",
        "supports"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "address",
              "position",
              "placeLink",
              "entrance",
              "navigation"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "position",
        "placeLink",
        "navigation"
      ],
      "properties": {
        "identity": {
          "type": "boolean"
        },
        "position": {
          "type": "boolean"
        },
        "placeLink": {
          "type": "boolean"
        },
        "navigation": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkedAt",
        "sources",
        "checks",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "unresolved"
          ]
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "description",
        "address",
        "position",
        "appleMaps",
        "entrance",
        "website",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "hotel",
            "see-do",
            "craft",
            "food-drink",
            "shopping"
          ]
        },
        "description": {
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "appleMaps": {
          "$ref": "#/$defs/appleMaps"
        },
        "entrance": {
          "anyOf": [
            {
              "$ref": "#/$defs/entrance"
            },
            {
              "type": "null"
            }
          ]
        },
        "website": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "properties": {
                  "status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "$ref": "#/$defs/position"
              },
              "appleMaps": {
                "anyOf": [
                  {
                    "properties": {
                      "placeId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "placeId"
                    ]
                  },
                  {
                    "properties": {
                      "placeUrl": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "placeUrl"
                    ]
                  }
                ]
              },
              "verification": {
                "properties": {
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sources": {
                    "minItems": 1
                  },
                  "checks": {
                    "properties": {
                      "identity": {
                        "const": true
                      },
                      "position": {
                        "const": true
                      },
                      "placeLink": {
                        "const": true
                      },
                      "navigation": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
