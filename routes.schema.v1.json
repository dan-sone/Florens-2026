{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Routes schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./routes.schema.v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 0
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "contentVersion",
    "updatedAt",
    "routes"
  ],
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "segments"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "mode": {
          "enum": [
            "walk",
            "transport",
            "taxi",
            "public-transit",
            "drive"
          ]
        },
        "placeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 2
        }
      },
      "required": [
        "id",
        "mode",
        "placeIds"
      ]
    }
  }
}
