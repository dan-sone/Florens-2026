{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Place stories schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contentVersion", "updatedAt", "stories"],
  "properties": {
    "$schema": {"const": "./stories.schema.v1.json"},
    "schemaVersion": {"const": 1},
    "contentVersion": {"type": "integer", "minimum": 1},
    "updatedAt": {"type": "string", "format": "date-time"},
    "stories": {"type": "array", "items": {"$ref": "#/$defs/story"}}
  },
  "$defs": {
    "story": {
      "type": "object", "additionalProperties": false,
      "required": ["placeId", "title", "paragraphs", "lookFor", "sources"],
      "properties": {
        "placeId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "paragraphs": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 1200}},
        "lookFor": {"type": "string", "minLength": 1, "maxLength": 600},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "url", "checkedAt"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "checkedAt": {"type": "string", "format": "date"}
      }
    }
  }
}
