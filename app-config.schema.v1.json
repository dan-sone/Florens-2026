{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contentVersion",
    "bookingCategoryId",
    "assistantQuestionTemplate",
    "onlineMap",
    "description"
  ],
  "properties": {
    "$schema": {
      "const": "./app-config.schema.v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "bookingCategoryId": {
      "type": "string",
      "minLength": 1
    },
    "assistantQuestionTemplate": {
      "type": "string",
      "allOf": [
        {
          "pattern": "\\{place\\}"
        },
        {
          "pattern": "\\{destination\\}"
        }
      ]
    },
    "onlineMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tileUrl",
        "options"
      ],
      "properties": {
        "tileUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "options": {
          "type": "object"
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excludedLinePrefixes"
      ],
      "properties": {
        "excludedLinePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
