{
  "$schema": "./app-config.schema.v1.json",
  "schemaVersion": 1,
  "contentVersion": 1,
  "bookingCategoryId": "booked",
  "assistantQuestionTemplate": "Berätta om {place} i {destination}: historia, kultur och vad som är särskilt intressant att uppmärksamma vid ett besök. Vi är särskilt intresserade av hantverk, konst och lokala traditioner.",
  "onlineMap": {
    "tileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "options": {
      "minZoom": 0,
      "maxZoom": 19,
      "maxNativeZoom": 19,
      "noWrap": false,
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
      "subdomains": "abc",
      "detectRetina": false,
      "tms": false,
      "opacity": 1
    }
  },
  "description": {
    "excludedLinePrefixes": [
      "Markören"
    ]
  }
}
