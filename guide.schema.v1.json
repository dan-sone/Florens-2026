{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guide schema v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./guide.schema.v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "searchSuffix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "searchSuffix"
      ]
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ]
        },
        "zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 19
        }
      },
      "required": [
        "center",
        "zoom"
      ]
    },
    "defaultSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                },
                "minItems": 1
              }
            },
            "required": [
              "nodes"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "label",
        "program"
      ]
    },
    "days": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/day"
      },
      "minItems": 1
    },
    "bookings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/booking"
      },
      "minItems": 0
    },
    "persistentPlaceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "booked",
              "see-do",
              "craft",
              "food-drink",
              "shopping",
              "hotel"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "minItems": 1
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "placeOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/override"
          }
        }
      },
      "required": [
        "placeOverrides"
      ]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "contentVersion",
    "updatedAt",
    "id",
    "title",
    "destination",
    "timeZone",
    "map",
    "defaultSelection",
    "days",
    "bookings",
    "persistentPlaceIds",
    "categories",
    "presentation"
  ],
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "text",
                "strong",
                "emphasis"
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "place"
            },
            "placeId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "placeId",
            "text"
          ]
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "markerColor": {
                  "type": "string",
                  "minLength": 1
                },
                "iconColor": {
                  "type": "string",
                  "minLength": 1
                },
                "icon": {
                  "type": "string",
                  "minLength": 1
                },
                "prefix": {
                  "enum": [
                    "fa",
                    "glyphicon"
                  ]
                },
                "className": {
                  "type": "string",
                  "minLength": 1
                },
                "html": {
                  "type": "string",
                  "minLength": 1
                },
                "iconSize": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "iconAnchor": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                },
                "popupAnchor": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2
                }
              },
              "required": []
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "type": "string"
        },
        "tooltip": {
          "type": "boolean"
        },
        "directionsUsesAddress": {
          "type": "boolean"
        },
        "mapLabel": {
          "type": "string",
          "minLength": 1
        },
        "descriptionSeparator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "icon",
        "style",
        "tooltip",
        "directionsUsesAddress",
        "mapLabel"
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "routeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "program": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                },
                "minItems": 1
              }
            },
            "required": [
              "nodes"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "date",
        "label",
        "routeIds",
        "program"
      ]
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "placeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "placeId",
        "startsAt"
      ]
    }
  }
}
