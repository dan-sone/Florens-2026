{
  "name": "florens-2026",
  "version": "1.20.0",
  "description": "Schema validation for the Florence travel guide",
  "scripts": {
    "build": "node tools/build-validator.cjs",
    "check": "node tools/check-content.cjs && npm run test:architecture",
    "build:offline": "node tools/prepare-offline.cjs",
    "extract:offline": "node tools/extract-offline.cjs",
    "test:offline": "node tools/test-offline.cjs",
    "fetch:offline": "node tools/fetch-offline-extras.cjs",
    "test:architecture": "node tools/check-offline-storage.cjs && node tools/check-app-separation.cjs && node tools/check-offline-update.cjs"
  },
  "type": "commonjs",
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.2.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@protomaps/basemaps": "^5.7.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bootstrap": "^5.2.2",
    "esbuild": "^0.25.12",
    "jquery": "^3.7.1",
    "jsdom": "30.1.3",
    "leaflet": "^1.9.3",
    "leaflet.awesome-markers": "^2.0.5",
    "leaflet.locatecontrol": "^0.66.2",
    "maplibre-gl": "^5.20.0",
    "playwright": "1.64.1",
    "pmtiles": "^4.5.0"
  },
  "private": true
}
